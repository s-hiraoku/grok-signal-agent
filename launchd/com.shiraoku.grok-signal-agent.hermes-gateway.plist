<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.shiraoku.grok-signal-agent.hermes-gateway</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/hermes</string>
    <string>gateway</string>
    <string>run</string>
    <string>--replace</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/.hermes/logs/hermes-gateway.out.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/.hermes/logs/hermes-gateway.err.log</string>
</dict>
</plist>
