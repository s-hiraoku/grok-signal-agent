<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.shiraoku.grok-signal-agent.weekly-self-reflection</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/.hermes/bin/hermes-weekly-self-reflection.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>PATH</key>
    <string>__HOME__/.local/bin:__HOME__/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HERMES_GBRAIN_RECONCILE</key>
    <string>1</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>__HOME__</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>21</integer>
    <key>Minute</key>
    <integer>10</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>__HOME__/.hermes/logs/hermes-weekly-self-reflection.out.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/.hermes/logs/hermes-weekly-self-reflection.err.log</string>
</dict>
</plist>
