{
  "version": 1,
  "channels": {
    "ai-news": "discord:replace-with-ai-news-channel-id",
    "tech-signals": "discord:replace-with-tech-signals-channel-id",
    "digest": "discord:replace-with-digest-channel-id",
    "hermes": "discord:replace-with-hermes-channel-id"
  },
  "jobs": [
    {
      "id": "tech-digest-0800",
      "name": "tech-digest 08:00",
      "enabled": false,
      "schedule": "0 8 * * *",
      "channel": "digest",
      "mode": "script",
      "script": "hermes-tech-digest-cron.sh",
      "no_agent": true,
      "prompt": "Run the tech digest script."
    },
    {
      "id": "tech-digest-1230",
      "name": "tech-digest 12:30",
      "enabled": false,
      "schedule": "30 12 * * *",
      "channel": "digest",
      "mode": "script",
      "script": "hermes-tech-digest-cron.sh",
      "no_agent": true,
      "prompt": "Run the tech digest script."
    },
    {
      "id": "tech-digest-1800",
      "name": "tech-digest 18:00",
      "enabled": true,
      "schedule": "0 18 * * 1-5",
      "channel": "digest",
      "mode": "script",
      "script": "hermes-tech-digest-cron.sh",
      "no_agent": true,
      "prompt": "Run the tech digest script."
    },
    {
      "id": "tech-digest-evaluate-1820",
      "name": "tech-digest evaluation 18:20",
      "enabled": true,
