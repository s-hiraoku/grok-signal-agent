{
  "version": 1,
  "settings": {
    "state_file": "~/.hermes/state/x-pulse-watcher-state.json",
    "log_file": "~/.hermes/logs/hermes-x-pulse-watcher.log",
    "env_file": "~/.hermes/.env",
    "hermes_bin": "~/.local/bin/hermes",
    "webhook_base_url_env": "HERMES_WEBHOOK_BASE_URL",
    "default_webhook_base_url": "http://127.0.0.1:8644",
    "post_trigger_secret_env": "HERMES_POST_TRIGGER_WEBHOOK_SECRET",
    "route": "x-buzz-trigger",
    "prime_only_on_first_run": true,
    "x_search_timeout_seconds": 240,
    "webhook_timeout_seconds": 20,
    "cooldown_minutes": 240,
    "early_window_minutes": 120,
    "max_window_minutes": 240,
    "min_likes_early": 250,
    "min_reposts_early": 40,
    "min_replies_quotes_early": 40,
    "min_views_early": 30000,
    "min_likes_notable": 150,
    "min_reposts_notable": 20,
    "min_replies_quotes_notable": 25,
    "min_views_notable": 20000,
    "min_likes_followup": 500,
    "min_reposts_followup": 80,
    "min_replies_quotes_followup": 80,
    "min_views_followup": 80000,
    "min_cluster_posts": 8,
    "min_cluster_engagement": 400,
    "min_qualified_urls": 1,
    "min_qualified_score": 350,
    "max_seen_urls": 400,
    "max_curation_chars": 6000
  },
  "queries": [
    "AI agents coding agents Claude Code Codex MCP OpenAI Grok xAI developer tools",
    "Web development TypeScript React JavaScript browser CSS frontend backend developer news",
    "GitHub Copilot Cursor IDE programming languages security cloud infrastructure open source"
  ]
}
