    "summary_latest_dir": "~/.hermes/public/ai-latest/latest",
    "summary_artifact_routes": ["ai-latest-trigger"],
    "summary_png_renderer": "playwright",
    "summary_cooldown_bypass_min_score": 100,
    "provider_split_routes": ["ai-latest-trigger"]
