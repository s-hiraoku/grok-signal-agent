{
  "version": 1,
  "settings": {
    "state_file": "~/.hermes/state/signal-watcher-state.json",
    "log_file": "~/.hermes/logs/hermes-signal-watcher.log",
    "env_file": "~/.hermes/.env",
    "webhook_base_url_env": "HERMES_WEBHOOK_BASE_URL",
    "default_webhook_base_url": "http://127.0.0.1:8644",
    "secret_env": "HERMES_SIGNAL_CATCHUP_WEBHOOK_SECRET",
    "post_trigger_secret_env": "HERMES_POST_TRIGGER_WEBHOOK_SECRET",
    "prime_only_on_first_run": true,
    "source_timeout_seconds": 20,
    "user_agent": "grok-signal-agent/0.1 (+https://github.com/s-hiraoku/grok-signal-agent)",
    "max_items_per_source": 30,
    "default_min_score": 56,
    "default_cooldown_minutes": 45,
    "batch_min_items": 5,
    "batch_min_score": 260,
    "batch_route": "tech-digest-trigger",
    "default_route": "signal-catchup"
  },
  "keyword_weights": {
    "agent": 24,
    "agents": 24,
    "ai agent": 30,
    "aiエージェント": 30,
    "エージェント": 24,
    "codex": 28,
    "anthropic": 24,
    "claude": 24,
    "claude code": 26,
    "grok": 22,
    "openai": 22,
    "cloudflare": 16,
    "workers": 16,
    "hacker news": 10,
    "ai": 14,
    "生成ai": 16,
    "copilot": 18,
    "mcp": 24,
    "model context protocol": 24,
    "browser": 12,
    "web api": 14,
    "typescript": 12,
    "react": 10,
    "security": 18,
    "セキュリティ": 18,
    "脆弱性": 22,
    "breaking": 24,
    "release": 16,
    "changelog": 16,
    "launch": 14,
    "障害": 18,
    "incident": 18,
    "github": 10,
    "devtools": 14,
    "playwright": 16,
    "rust": 10,
    "go": 8,
    "python": 8,
    "kubernetes": 12,
    "docker": 10,
    "css": 8,
    "web": 8
  },
  "sources": [
    {
      "id": "zenn-trending",
      "enabled": true,
      "type": "feed",
      "url": "https://zenn.dev/feed",
      "description": "Zenn trending RSS feed.",
      "base_score": 42,
      "min_score": 52,
      "route": "zenn-dev-trigger",
      "tags": ["zenn", "ja-tech"]
    },
    {
      "id": "wbsb-feed",
      "enabled": true,
      "type": "feed",
      "url": "https://wbsb.dev/api/feed/atom",
      "description": "wbsb.dev Atom feed for new Japanese technical articles.",
      "base_score": 38,
      "min_score": 50,
      "route": "wbsb-trigger",
      "tags": ["wbsb", "ja-tech"]
    },
    {
      "id": "wbsb-new-html",
      "enabled": true,
      "type": "html_links",
      "url": "https://wbsb.dev/?tab=new",
      "description": "wbsb.dev new page fallback when feed shape changes.",
      "base_score": 30,
      "min_score": 50,
      "route": "wbsb-trigger",
      "include_url_patterns": ["/articles/"],
      "exclude_url_patterns": ["/api/", "/info/", "/user/"],
      "tags": ["wbsb", "ja-tech", "fallback"]
    },
    {
      "id": "hermes-agent-releases",
      "enabled": true,
      "type": "feed",
      "url": "https://github.com/NousResearch/hermes-agent/releases.atom",
      "description": "Hermes Agent upstream releases.",
      "base_score": 60,
      "min_score": 70,
      "route": "signal-catchup",
      "tags": ["hermes", "release"]
    },
    {
      "id": "github-changelog",
      "enabled": true,
      "type": "feed",
      "url": "https://github.blog/changelog/feed/",
      "description": "GitHub Changelog feed for GitHub, Copilot, Actions, and platform updates.",
      "base_score": 46,
      "min_score": 62,
      "route": "signal-catchup",
      "tags": ["github", "changelog", "developer-tools"]
    },
    {
      "id": "openai-news",
      "enabled": true,
      "type": "feed",
      "url": "https://openai.com/news/rss.xml",
      "description": "OpenAI official news feed.",
      "base_score": 54,
      "min_score": 64,
      "route": "signal-catchup",
      "tags": ["openai", "ai", "official"]
    },
    {
      "id": "cloudflare-changelog",
      "enabled": true,
      "type": "feed",
      "url": "https://developers.cloudflare.com/changelog/rss/index.xml",
      "description": "Cloudflare official changelog feed for platform, Workers, security, and networking updates.",
      "base_score": 48,
      "min_score": 62,
      "route": "signal-catchup",
      "tags": ["cloudflare", "changelog", "infrastructure", "security"]
    },
    {
      "id": "hn-frontpage",
      "enabled": true,
      "type": "feed",
      "url": "https://hnrss.org/frontpage",
      "description": "Hacker News front page feed for developer community signals.",
      "base_score": 40,
      "min_score": 58,
      "route": "signal-catchup",
      "tags": ["hacker-news", "community"]
    },
    {
      "id": "hn-best",
      "enabled": true,
      "type": "feed",
      "url": "https://hnrss.org/best",
      "description": "Hacker News best feed for high-traction developer community signals.",
      "base_score": 44,
      "min_score": 58,
      "route": "signal-catchup",
      "tags": ["hacker-news", "community"]
    },
    {
      "id": "publickey",
      "enabled": true,
      "type": "feed",
      "url": "https://www.publickey1.jp/atom.xml",
      "description": "Publickey Japanese enterprise IT and developer news feed.",
      "base_score": 44,
      "min_score": 56,
      "route": "signal-catchup",
      "tags": ["publickey", "ja-tech", "it-news"]
    },
    {
      "id": "anthropic-news",
      "enabled": true,
      "type": "html_links",
      "url": "https://www.anthropic.com/news",
      "description": "Anthropic official news and product announcements.",
      "base_score": 48,
      "min_score": 58,
      "route": "signal-catchup",
      "include_url_patterns": ["/news/"],
      "exclude_url_patterns": [],
      "tags": ["anthropic", "ai", "official"]
    },
    {
      "id": "anthropic-engineering",
      "enabled": true,
      "type": "html_links",
      "url": "https://www.anthropic.com/engineering",
      "description": "Anthropic engineering articles, including Claude and agent engineering notes.",
      "base_score": 60,
      "min_score": 58,
      "route": "signal-catchup",
      "include_url_patterns": ["/engineering/"],
      "exclude_url_patterns": [],
      "tags": ["anthropic", "claude", "engineering", "ai-agent"]
    },
    {
      "id": "anthropic-research",
      "enabled": true,
      "type": "html_links",
      "url": "https://www.anthropic.com/research",
      "description": "Anthropic research articles relevant to AI systems, agents, safety, and evaluation.",
      "base_score": 54,
      "min_score": 58,
      "route": "signal-catchup",
      "include_url_patterns": ["/research/"],
      "exclude_url_patterns": ["/research/team/"],
      "tags": ["anthropic", "claude", "research", "ai"]
    }
  ]
}
