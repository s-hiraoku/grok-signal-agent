{
  "version": 1,
  "settings": {
    "state_file": "~/.hermes/state/signal-watcher-state.json",
    "log_file": "~/.hermes/logs/hermes-signal-watcher.log",
    "env_file": "~/.hermes/.env",
    "webhook_base_url_env": "HERMES_WEBHOOK_BASE_URL",
    "default_webhook_base_url": "http://127.0.0.1:8644",
    "secret_env": "HERMES_SIGNAL_CATCHUP_WEBHOOK_SECRET",
    "post_trigger_secret_env": "HERMES_POST_TRIGGER_WEBHOOK_SECRET",
    "prime_only_on_first_run": true,
    "source_timeout_seconds": 20,
    "user_agent": "grok-signal-agent/0.1 (+https://github.com/s-hiraoku/grok-signal-agent)",
    "max_items_per_source": 20,
    "default_min_score": 70,
    "default_cooldown_minutes": 90,
    "batch_min_items": 4,
    "batch_min_score": 220,
    "batch_route": "tech-digest-trigger",
    "default_route": "signal-catchup"
  },
  "keyword_weights": {
    "agent": 24,
    "agents": 24,
    "ai agent": 30,
    "aiエージェント": 30,
    "エージェント": 24,
    "codex": 28,
    "claude code": 26,
    "grok": 22,
    "openai": 22,
    "mcp": 24,
    "model context protocol": 24,
    "browser": 12,
    "web api": 14,
    "typescript": 12,
    "react": 10,
    "security": 18,
    "脆弱性": 22,
    "breaking": 24,
    "release": 16,
    "changelog": 16,
    "launch": 14,
    "障害": 18,
    "incident": 18,
    "github": 10,
    "rust": 10,
    "go": 8,
    "python": 8,
    "kubernetes": 12,
    "docker": 10,
    "css": 8,
    "web": 8
  },
  "sources": [
    {
      "id": "zenn-trending",
      "enabled": true,
      "type": "feed",
      "url": "https://zenn.dev/feed",
      "description": "Zenn trending RSS feed.",
      "base_score": 42,
      "min_score": 72,
      "route": "signal-catchup",
      "tags": ["zenn", "ja-tech"]
    },
    {
      "id": "wbsb-feed",
      "enabled": true,
      "type": "feed",
      "url": "https://wbsb.dev/api/feed/atom",
      "description": "wbsb.dev Atom feed for new Japanese technical articles.",
      "base_score": 38,
      "min_score": 68,
      "route": "signal-catchup",
      "tags": ["wbsb", "ja-tech"]
    },
    {
      "id": "wbsb-new-html",
      "enabled": true,
      "type": "html_links",
      "url": "https://wbsb.dev/?tab=new",
      "description": "wbsb.dev new page fallback when feed shape changes.",
      "base_score": 30,
      "min_score": 78,
      "route": "signal-catchup",
      "include_url_patterns": ["/articles/"],
      "exclude_url_patterns": ["/api/", "/info/", "/user/"],
      "tags": ["wbsb", "ja-tech", "fallback"]
    },
    {
      "id": "hermes-agent-releases",
      "enabled": true,
      "type": "feed",
      "url": "https://github.com/NousResearch/hermes-agent/releases.atom",
      "description": "Hermes Agent upstream releases.",
      "base_score": 60,
      "min_score": 70,
      "route": "signal-catchup",
      "tags": ["hermes", "release"]
    }
  ]
}
