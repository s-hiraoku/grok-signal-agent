# Copy this file to ~/.hermes/.env on the VM and replace placeholders.
# Never commit the real ~/.hermes/.env file.

# Force Hermes to use xAI Grok OAuth when needed.
HERMES_INFERENCE_PROVIDER=xai-oauth

# Discord gateway secrets. Replace with values from Discord Developer Portal
# and your Discord numeric user ID.
DISCORD_BOT_TOKEN=replace-with-your-discord-bot-token
DISCORD_ALLOWED_USERS=123456789012345678

# Optional. Usually leave unset unless Hermes documentation or support asks for it.
# XAI_BASE_URL=https://api.x.ai/v1

# Optional digest quality behavior.
# HERMES_DIGEST_LINT_STRICT=1

# Optional operational alerts. The helper always writes ~/.hermes/logs/hermes-alerts.log.
# HERMES_ALERT_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# HERMES_ALERT_COMMAND='your-command-that-reads-stdin'

# Optional event-driven webhook ingress. Keep disabled unless the gateway is
# reachable only from trusted sources or protected by a tunnel/firewall. Set
# platforms.webhook.extra.host in ~/.hermes/config.yaml if you need local-only
# binding; Hermes v0.14.0 does not read WEBHOOK_HOST from .env.
# WEBHOOK_ENABLED=true
# WEBHOOK_PORT=8644
# WEBHOOK_SECRET=replace-with-global-hmac-secret
# HERMES_SIGNAL_CATCHUP_WEBHOOK_SECRET=replace-with-route-hmac-secret
# HERMES_POST_TRIGGER_WEBHOOK_SECRET=replace-with-post-trigger-route-secret
# HERMES_WEBHOOK_BASE_URL=http://127.0.0.1:8644

# Optional Obsidian vault path used by scripts/hermes-obsidian-mcp-setup.sh.
# OBSIDIAN_VAULT_PATH=/Users/you/Documents/Notes

# Optional Jina API key for higher Jina Reader/MCP rate limits.
# JINA_API_KEY=jina_xxx

# Do not put xAI OAuth tokens here.
# Hermes stores xAI OAuth credentials in ~/.hermes/auth.json.
